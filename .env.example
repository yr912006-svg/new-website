# Core
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/preheritage?sslmode=require
# Admin access: comma-separated allowlisted email addresses; also create Admin records in DB
ADMIN_EMAILS=admin@example.com

# Google OAuth (Google Cloud Console callback: /api/auth/callback/google)
NEXT_PUBLIC_GOOGLE_ENABLED=false
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Twilio Verify (OTP login API uses E.164 phone numbers)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Razorpay (server-side order creation and payment signature verification)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudinary signed uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional future integrations
RESEND_API_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
